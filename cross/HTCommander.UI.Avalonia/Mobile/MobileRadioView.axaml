<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HTCommander.UI.Avalonia.ViewModels"
             xmlns:abs="using:HTCommander.Core.Abstractions"
             x:Class="HTCommander.UI.Avalonia.Mobile.MobileRadioView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="14" Spacing="12">

      <!-- Connection -->
      <Border Classes="mCard">
        <StackPanel Spacing="10">
          <TextBlock Classes="mKey" Text="RADIO"/>
          <ComboBox Classes="mInput" ItemsSource="{Binding Radios}" SelectedItem="{Binding SelectedRadio}"
                    PlaceholderText="Tap Refresh to find your radio">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="abs:RadioDeviceInfo">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" x:Name="RefreshButton" Classes="mGhost" Content="Refresh"/>
            <Button Grid.Column="1" x:Name="ConnectButton" Classes="mPri" Content="Connect" IsEnabled="{Binding CanConnect}"/>
            <Button Grid.Column="2" x:Name="DisconnectButton" Classes="mGhost" Content="Disconnect" IsEnabled="{Binding CanDisconnect}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Radio image with on-screen status overlay (mirrors the desktop HUD): the radio's
           current channel number + name, and TX/RX state, drawn over the radio's screen. -->
      <Border Classes="mCard" Padding="8">
        <Grid Width="180" Height="340" HorizontalAlignment="Center">
          <Image Source="/Assets/Radio.png" Stretch="Uniform"/>
          <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,96,0,0"
                  Width="112" Height="70" Padding="6,4" CornerRadius="3"
                  Background="#B0091505" IsVisible="{Binding HasStatus}">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <TextBlock Foreground="#86F29A" FontFamily="monospace" FontWeight="Bold" FontSize="12"
                           Text="{Binding ChannelId, Converter={StaticResource PlusOne}, StringFormat='CH {0}'}"/>
                <TextBlock Foreground="#86F29A" FontFamily="monospace" FontWeight="Bold" FontSize="12"
                           Text="{Binding CurrentChannelName}" IsVisible="{Binding HasCurrentChannelName}"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Text="{Binding TxRxState}" Foreground="#86F29A" FontFamily="monospace"
                         FontSize="10" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Mode explainer: always describes the current mode (Packet / Voice / Digital) in
           plain language. Neutral for Packet (normal data mode); amber when packet is blocked. -->
      <Border IsVisible="{Binding IsPacketMode}" Background="{StaticResource MTint}" BorderBrush="{StaticResource MTintLine}"
              BorderThickness="1" CornerRadius="12" Padding="12">
        <TextBlock Text="{Binding ModeSummary}" Foreground="{StaticResource MAccent2}" TextWrapping="Wrap" FontSize="12.5"/>
      </Border>
      <Border IsVisible="{Binding IsModeCaution}" Background="#f4ecd6" BorderBrush="#cbab5e"
              BorderThickness="1" CornerRadius="12" Padding="12">
        <TextBlock Text="{Binding ModeSummary}" Foreground="#7a5a16" TextWrapping="Wrap" FontSize="12.5"/>
      </Border>

      <!-- Status cards -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
        <Border Grid.Row="0" Grid.Column="0" Classes="mCard">
          <StackPanel Spacing="4"><TextBlock Classes="mKey" Text="CONNECTION"/>
            <TextBlock Text="{Binding Status}" FontFamily="{StaticResource MMono}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource MAccent2}" TextTrimming="CharacterEllipsis"/></StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Classes="mCard">
          <StackPanel Spacing="4"><TextBlock Classes="mKey" Text="CHANNEL"/>
            <TextBlock Classes="mVal" Text="{Binding ChannelId, Converter={StaticResource PlusOne}, StringFormat='CH {0}'}"/></StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Classes="mCard">
          <StackPanel Spacing="4"><TextBlock Classes="mKey" Text="BATTERY"/>
            <TextBlock Classes="mVal" Text="{Binding BatteryPercent, StringFormat='{}{0}%'}"/></StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Classes="mCard">
          <StackPanel Spacing="4"><TextBlock Classes="mKey" Text="FRAMES RX"/>
            <TextBlock Classes="mVal" Text="{Binding FrameCount}"/></StackPanel>
        </Border>
      </Grid>

      <!-- Recent APRS -->
      <TextBlock Classes="mSection" Text="RECENT APRS"/>
      <ItemsControl ItemsSource="{Binding AprsMessages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AprsMessageRow">
            <Border Classes="mRow">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Header}" Classes="mMono" FontSize="12" Foreground="{StaticResource MMut}"/>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Voice PTT, modem and clips arrive in round two (audio)." Classes="mKey"
                 TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
