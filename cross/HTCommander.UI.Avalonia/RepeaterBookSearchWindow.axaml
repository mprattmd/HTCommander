<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HTCommander.UI.Avalonia.ViewModels"
        x:Class="HTCommander.UI.Avalonia.RepeaterBookSearchWindow"
        x:DataType="vm:RepeaterBookSearchViewModel"
        Width="760" Height="560" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface0Brush}"
        Icon="/Assets/HTCommander.ico"
        Title="Search RepeaterBook">
    <DockPanel Margin="16">

        <!-- Search inputs -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Service" VerticalAlignment="Center" Margin="0,4,8,4"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,4">
                <ComboBox MinWidth="120" ItemsSource="{Binding ServiceOptions}" SelectedItem="{Binding SelectedService}"/>
                <TextBlock Text="GMRS: US only, FM" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsAmateur}"/>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Band" VerticalAlignment="Center" Margin="12,4,8,4"/>
            <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" Margin="0,4"
                      ItemsSource="{Binding BandOptions}" SelectedItem="{Binding SelectedBand}"
                      IsEnabled="{Binding BandEnabled}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Country" VerticalAlignment="Center" Margin="0,4,8,4"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Country}" Watermark="United States"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Mode" VerticalAlignment="Center" Margin="12,4,8,4"/>
            <ComboBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" Margin="0,4"
                      ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}"
                      IsEnabled="{Binding IsAmateur}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="State / Prov." VerticalAlignment="Center" Margin="0,4,8,4"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding State}" Watermark="e.g. Colorado"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="County" VerticalAlignment="Center" Margin="12,4,8,4"/>
            <TextBox Grid.Row="2" Grid.Column="3" Margin="0,4" Text="{Binding County}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="City" VerticalAlignment="Center" Margin="0,4,8,4"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding City}"/>
            <StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="12,4,0,4">
                <CheckBox Content="Within" IsChecked="{Binding UseProximity}" IsEnabled="{Binding ProximityAvailable}"
                          VerticalAlignment="Center"/>
                <NumericUpDown Width="110" Minimum="1" Maximum="500" Increment="5" Value="{Binding ProximityMiles}"
                               IsEnabled="{Binding UseProximity}"/>
                <TextBlock Text="miles of me" VerticalAlignment="Center"/>
                <TextBlock Text="(needs GPS fix)" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                           IsVisible="{Binding !ProximityAvailable}"/>
            </StackPanel>
        </Grid>

        <!-- Action bar (bottom) -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,10,0,0">
            <Button Grid.Column="0" x:Name="SelectAllButton" Content="Select all" Margin="0,0,8,0"/>
            <Button Grid.Column="1" x:Name="SelectNoneButton" Content="Clear"/>
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InfoBrush}"/>
            <Button Grid.Column="3" x:Name="CancelButton" Content="Close" Margin="0,0,8,0" Padding="16,4"/>
            <Button Grid.Column="4" x:Name="AddButton" Content="Add selected to builder" Padding="16,4"
                    Classes="accent"/>
        </Grid>

        <!-- Search button row -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="SearchButton" Content="Search" Padding="20,4" IsEnabled="{Binding CanSearch}"/>
            <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" IsVisible="{Binding IsSearching}"/>
        </StackPanel>

        <!-- Results -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}"
                      IsReadOnly="False" CanUserReorderColumns="False" CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Add" Binding="{Binding IsSelected}" Width="44"/>
                    <DataGridTextColumn Header="Callsign" Binding="{Binding Callsign}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Output" Binding="{Binding Output}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Tone" Binding="{Binding Tone}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
